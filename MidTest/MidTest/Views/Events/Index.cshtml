@model IEnumerable<MidTest.Models.Event_BIT240104>

<h2>Danh sách sự kiện</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="card p-3 mb-4 bg-light">
    <div class="form-row align-items-end row">
        <div class="col-md-3 mb-2">
            <label>Tìm theo tên/địa điểm</label>
            <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Nhập từ khóa..." />
        </div>
        <div class="col-md-3 mb-2">
            <label>Loại sự kiện</label>
            <select name="categoryId" class="form-control" asp-items="ViewBag.Categories">
                <option value="">-- Tất cả loại --</option>
            </select>
        </div>
        <div class="col-md-2 mb-2">
            <label>Từ ngày bắt đầu</label>
            <input type="datetime-local" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
        </div>
        <div class="col-md-2 mb-2">
            <label>Sắp xếp theo</label>
            <select name="sortBy" class="form-control">
                <!option value="date_desc" @(ViewBag.SortBy == "date_desc" ? "selected" : "")>Mới nhất</!option>
                <!option value="price_asc" @(ViewBag.SortBy == "price_asc" ? "selected" : "")>Giá tăng dần</!option>
                <!option value="price_desc" @(ViewBag.SortBy == "price_desc" ? "selected" : "")>Giá giảm dần</!option>
            </select>
        </div>
        <div class="col-md-2 mb-2">
            <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
        </div>
    </div>
</form>

<p><a asp-action="Create" class="btn btn-success">Thêm sự kiện mới</a></p>

@if (ViewBag.EmptyMessage != null)
{
    <div class="alert alert-warning">@ViewBag.EmptyMessage</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Ảnh đại diện</th>
                <th>Tên sự kiện</th>
                <th>Loại</th>
                <th>Giá</th>
                <th>Thời gian</th>
                <th>Địa điểm</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                string thumb = null;
                if (item.EventImages != null && item.EventImages.Any())
                {
                    thumb = item.EventImages.FirstOrDefault(i => i.IsThumbnail)?.ImageUrl
                            ?? item.EventImages.FirstOrDefault()?.ImageUrl;
                }

                <tr>
                    <td align="center">
                        @if (!string.IsNullOrEmpty(thumb))
                        {
                            <img src="@thumb" width="80" height="60" style="object-fit: cover;" class="img-thumbnail" />
                        }
                        else
                        {
                            <span class="text-muted">Không ảnh</span>
                        }
                    </td>
                    <td><b>@item.Name</b></td>
                    <td>@(item.EventCategory?.Name ?? "Chưa phân loại")</td>
                    <td>@item.Price.ToString("N0") đ</td>
                    <td>
                        <small>BD: @item.StartDate.ToString("dd/MM/yyyy HH:mm")</small><br />
                        <small>KT: @item.EndDate.ToString("dd/MM/yyyy HH:mm")</small>
                    </td>
                    <td>@item.Location</td>
                    <td>
                        @if (item.Status == "Sắp diễn ra")
                        {
                            <span class="badge bg-warning text-dark">Sắp diễn ra</span>
                        }
                        else if (item.Status == "Đang diễn ra")
                        {

                            <span class="badge bg-success text-white">Đang diễn ra</span>
                        }
                        else
                        {

                            <span class="badge bg-secondary text-white">Đã kết thúc</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Xem</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}