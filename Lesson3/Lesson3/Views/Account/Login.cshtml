@{
    ViewData["Title"] = "Login";
}

<h2>Login Form</h2>

<form method="post">
    <div>
        <label>Username:</label>
        <input type="text" name="username" />
    </div>

    <br />

    <div>
        <label>Password:</label>
        <input type="password" name="password" />
    </div>

    <br />

    <button type="submit">Login</button>
</form>

@if (ViewBag.Message != null)
{
    <h3>@ViewBag.Message</h3>
}