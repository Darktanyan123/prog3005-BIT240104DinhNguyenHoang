@model Lesson3.Models.Book

@if (Model == null)
{
    <h2>Không tìm thấy sách</h2>
    <a href="/Book/Index">Back to List</a>
}
else
{
    <h2>Book Detail</h2>

    <p><strong>Id:</strong> @Model.Id</p>
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Price:</strong> @Model.Price</p>

    <a href="/Book/Index">Back to List</a>
}