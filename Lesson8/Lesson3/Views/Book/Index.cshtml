@model List<Lesson3.Models.Book>

<h2>Danh sách sách</h2>

<p>
    <a asp-action="Create">Add New Book</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Tên sách</th>
            <th>Giá</th>
            <th>Hình ảnh</th>
            <th>Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>

                <td>@item.Name</td>

                <td>@item.Price</td>

                <td>
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl"
                             width="100"
                             height="100"
                             style="object-fit:cover;" />
                    }
                    else
                    {
                        <span>Không có ảnh</span>
                    }
                </td>

                <td>
                    <a asp-action="Detail"
                       asp-route-id="@item.Id">
                        Detail
                    </a>
                    |

                    <a asp-action="Edit"
                       asp-route-id="@item.Id">
                        Sửa
                    </a>
                    |

                    <a asp-action="Delete"
                       asp-route-id="@item.Id">
                        Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>